{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caller-owned ten-source manifest schema, not an actual image manifest",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "file",
      "sha256",
      "width",
      "height"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "file": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$comment": "Caller must also ensure unique id values and readable local files. The schema contains no input data."
}
